{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TAnalytic",
  "version": "0.31.0",
  "identifier": "ru.tanalytic.app",
  "build": {
    "frontendDist": "icons"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TAnalytic",
        "url": "about:blank",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#07090e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
