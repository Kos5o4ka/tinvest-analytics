[Unit]
Description=TAnalytic calculations worker (heavy public-market calcs -> /var/lib/tinvest-server/calc/*.json)
After=network-online.target
Wants=network-online.target

[Service]
User=tinvest
Group=tinvest
# Токен T-Invest не нужен: считаются только публичные данные Мосбиржи.
ExecStart=/usr/bin/python3 /opt/tinvest-analytics/server/calc_worker.py --data /var/lib/tinvest-server
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tinvest-server

[Install]
WantedBy=multi-user.target
